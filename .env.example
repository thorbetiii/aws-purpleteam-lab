# Copy this file to .env for local development.
# These database values are intentionally local-only examples. Replace them
# with secrets from an appropriate secret store outside local development.
APP_NAME="AWS Cloud Security Purple Team Lab"
APP_ENVIRONMENT=local
APP_VERSION=0.2.0
APP_DEBUG=false

POSTGRES_DB=purple_team_lab
POSTGRES_USER=purple_team_app
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_PORT=5432

APP_DATABASE_URL="postgresql+psycopg://purple_team_app:local-dev-only-change-me@127.0.0.1:5432/purple_team_lab"
